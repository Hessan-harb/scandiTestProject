{
    "name": "hussein/scandiweb-test",
    "description": "Scandiweb Junior Full Stack test task - vanilla PHP 8 GraphQL backend",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "webonyx/graphql-php": "^15.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "import": "php scripts/import.php",
        "serve": "php -S localhost:8000 -t public"
    }
}
